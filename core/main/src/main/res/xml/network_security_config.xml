<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="true">localhost</domain>
        <!-- archlinuxarm.org redirects its tarball to plain HTTP; this keeps the
             fallback mirror usable when the HTTPS mirrors are unavailable. -->
        <domain includeSubdomains="true">archlinuxarm.org</domain>
    </domain-config>
</network-security-config>
